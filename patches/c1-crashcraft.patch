+/* CrashCraft: depth state for a prim's depth mode (PRIM_DEPTH_*) and blend flags */
+static void GLSetDepthMode(int depth, int flags) {
+  switch (depth) {
+  case PRIM_DEPTH_TEST:
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LEQUAL);
+    glDepthMask((flags == 0 || flags == 3) ? GL_TRUE : GL_FALSE); /* additive/subtractive don't occlude */
+    glDepthRange(0.0, 1.0);
+    break;
+  case PRIM_DEPTH_FRONT:
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_ALWAYS);
+    glDepthMask(GL_TRUE);
+    glDepthRange(0.0, 0.0); /* nearest: nothing drawn later covers it */
+    break;
+  default: /* PRIM_DEPTH_NONE, PRIM_DEPTH_BACK */
+    glDisable(GL_DEPTH_TEST);
+    glDepthMask(GL_FALSE);
+    glDepthRange(0.0, 1.0);
