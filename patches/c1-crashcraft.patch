+static void GLSetupScreen() {
+  int w, h, vw, vx;
+  float half;
+  SDL_GL_GetDrawableSize(SDL_GL_GetCurrentWindow(), &w, &h);
+  if (w <= 0 || h <= 0) { w = 1024; h = 768; }
+  glDisable(GL_SCISSOR_TEST);
